---
import Layout from '../layouts/Layout.astro';
import {projects,href} from '../data/site';
---
<Layout title="Projects"><div class="page-intro"><span class="eyebrow">04 / Projects</span><h1>Tools for understanding.</h1><p>研究と学習を支える、動かせる道具。</p></div><div class="grid">{projects.map(p => <article class="card"><img src={href(p.image)} alt="経路探索の概念図"/><h2>{p.title}</h2><p>{p.description}</p><div class="tags">{p.tags.map(t => <span class="tag">{t}</span>)}</div><div class="actions"><a href={p.github}>GitHub ↗</a><a href={href(p.wiki)}>関連Wiki →</a></div></article>)}</div></Layout>
