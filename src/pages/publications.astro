---
import Layout from '../layouts/Layout.astro';
import {publications} from '../data/site';
const years = [...new Set(publications.map(p => p.year))].sort((a,b)=>b-a);
---
<Layout title="Publications"><div class="page-intro"><span class="eyebrow">03 / Publications</span><h1>Publications</h1><p class="note">研究業績は未登録です。以下は架空のサンプルであり、本人の研究業績ではありません。</p></div><label>種類で絞り込む <select id="publication-filter"><option value="all">すべて</option><option value="conference">国際会議</option><option value="journal">ジャーナル</option><option value="preprint">プレプリント</option></select></label><p id="empty-publications" hidden>該当する業績はありません。</p>{years.map(year => <section class="section" data-year><h2>{year}</h2>{publications.filter(p => p.year === year).map(p => <article class="publication" data-type={p.type} id={p.id}><span class="tag">{p.type} / 架空サンプル</span><h3>{p.title}</h3><p>{p.authors}</p><p>{p.venue} · {p.year}</p><div class="actions">{p.doi && <a href={`https://doi.org/${p.doi}`}>DOI ↗</a>}{p.pdf && <a href={p.pdf}>PDF ↗</a>}</div><details><summary>BibTeXを表示</summary><pre>{p.bibtex}</pre><button class="button copy-bib">Copy BibTeX</button></details></article>)}</section>)}</Layout>
<script>
 document.querySelector('#publication-filter')?.addEventListener('change', event => { const value=(event.target as HTMLSelectElement).value; document.querySelectorAll<HTMLElement>('[data-type]').forEach(item => item.hidden=value !== 'all' && item.dataset.type !== value); document.querySelectorAll<HTMLElement>('[data-year]').forEach(section => section.hidden=!section.querySelector('[data-type]:not([hidden])')); (document.querySelector('#empty-publications') as HTMLElement).hidden=!!document.querySelector('[data-type]:not([hidden])'); });
 document.querySelectorAll<HTMLButtonElement>('.copy-bib').forEach(button => button.addEventListener('click',async()=>{try{await navigator.clipboard.writeText(button.previousElementSibling?.textContent || '');button.textContent='コピーしました';}catch{button.textContent='コピーできませんでした';}}));
</script>
